import Link from "next/link";
import { prisma } from "@/lib/prisma";
import { ProductCard } from "@/components/product/ProductCard";
import { PackageX, Sparkles } from "lucide-react";

export const dynamic = "force-dynamic";

export default async function BundlesPage() {
  // Fetch all bundles from the database
  const bundles = await prisma.product.findMany({
    where: { isBundle: true, isActive: true, approvalStatus: "APPROVED" },
    include: { 
      images: { take: 1 }, 
      vendor: true, 
      category: true, 
      variants: true, 
      reviews: true 
    },
    orderBy: { createdAt: "desc" }
  });

  // Map to the shape expected by ProductCard
  const mappedBundles = bundles.map((p) => ({
    ...p,
    category: p.category.slug,
    vendorSlug: p.vendor.slug,
    images: p.images.map(i => i.url),
    specs: (p.specs as unknown) as { label: string; value: string }[],
    rating: p.rating,
    reviewCount: p.reviewCount,
    tags: p.tags as string[],
  }));

  return (
    <div className="mx-auto max-w-[1440px] px-4 py-8">
      <nav className="text-xs text-muted mb-6 flex gap-2"><Link href="/" className="hover:text-primary">Home</Link><span>/</span><span className="text-charcoal font-medium">Bundles & Deals</span></nav>
      
      <div className="mb-8 text-center max-w-2xl mx-auto">
        <div className="inline-flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary mb-4">
          <Sparkles size={24} />
        </div>
        <h1 className="text-3xl md:text-4xl font-extrabold text-charcoal">Bundle & Save</h1>
        <p className="text-sm md:text-base text-muted mt-3">
          Get everything you need in one package. These bundles are curated by our verified vendors and brands for maximum value.
        </p>
      </div>

      {mappedBundles.length === 0 ? (
        <div className="rounded-xl border border-dashed border-border bg-white p-12 text-center max-w-lg mx-auto">
          <PackageX size={40} className="mx-auto text-muted mb-4" />
          <h2 className="text-lg font-bold text-charcoal mb-2">No Bundles Available</h2>
          <p className="text-sm text-muted">Vendors are working on new packages. Check back soon!</p>
        </div>
      ) : (
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {mappedBundles.map((b) => (
            <ProductCard key={b.id} product={b as never} />
          ))}
        </div>
      )}
    </div>
  );
}