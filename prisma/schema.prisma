generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  PAY_ON_DELIVERY
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED
}

enum ShipmentCarrier {
  ISOURCE
  VENDOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       ProductReview[]
  vendor        Vendor?

  @@index([email])
}

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  slug        String       @unique
  name        String
  description String?
  logoUrl     String?
  status      VendorStatus @default(PENDING)
  isIsource   Boolean      @default(false)
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([status])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]
}

model Product {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  shortDescription  String
  description       String
  categoryId        String
  vendorId          String
  sku               String   @unique
  priceKobo         Int
  originalPriceKobo Int?
  stock             Int      @default(0)
  specs             Json
  tags              String[]
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  isActive          Boolean  @default(true)
  isFeatured        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category        @relation(fields: [categoryId], references: [id])
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           ProductReview[]
  orderItems        OrderItem[]
  cartItems         CartItem[]

  @@index([categoryId, isActive])
  @@index([vendorId])
  @@index([slug])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  label     String
  sku       String   @unique
  stock     Int      @default(0)
  priceKobo Int
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  qty       Int
  createdAt DateTime @default(now())

  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

model Order {
  id                   String          @id @default(cuid())
  orderNumber          String          @unique
  userId               String?
  guestEmail           String?
  guestPhone           String?
  status               OrderStatus     @default(PENDING)
  paymentStatus        PaymentStatus   @default(PENDING)

  shippingFirstName    String
  shippingLastName     String
  shippingPhone        String
  shippingStreet       String
  shippingCity         String
  shippingState        String
  shippingPostalCode   String?
  shippingInstructions String?

  deliveryMethod       String
  paymentMethod        PaymentProvider
  subtotalKobo         Int
  deliveryKobo         Int
  discountKobo         Int             @default(0)
  totalKobo            Int

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User?           @relation(fields: [userId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  shipments            Shipment[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?

  productName       String
  variantLabel      String?
  sku               String
  unitKobo          Int
  qty               Int
  lineTotalKobo     Int

  vendorId          String

  fulfillmentStatus FulfillmentStatus @default(PENDING)
  vendorManaged     Boolean           @default(false)

  createdAt         DateTime          @default(now())

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?          @relation(fields: [productId], references: [id])
  variant           ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([fulfillmentStatus])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerReference String?         @unique
  status            PaymentStatus   @default(PENDING)
  amountKobo        Int
  currency          String          @default("NGN")
  paidAt            DateTime?
  rawResponse       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerReference])
  @@index([status])
}

model Shipment {
  id              String            @id @default(cuid())
  orderId         String
  carrier         ShipmentCarrier   @default(ISOURCE)
  trackingNumber  String?
  status          FulfillmentStatus @default(PENDING)
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  proofOfDelivery String?
  podCollected    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  state         String
  city          String?
  feeKobo       Int
  freeAboveKobo Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([state])
}

model SiteSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}