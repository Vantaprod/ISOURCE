generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  BRAND
  ADMIN
}

enum VendorStatus {
  PENDING
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REQUIRES_INFORMATION
  APPROVED
  REJECTED
  SUSPENDED
  CLOSED
}

enum BrandStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  PROCESSING
  SUCCESSFUL
  ABANDONED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  BANK_TRANSFER
  PAY_ON_DELIVERY
  MONNIFY
  MANUAL
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED
}

enum ShipmentCarrier {
  ISOURCE
  VENDOR
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  storeFollows  StoreFollower[]
  role          UserRole        @default(CUSTOMER)
  lastLoginAt   DateTime?
  avatarUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       ProductReview[]
  vendor        Vendor?
  brands        Brand[]
  memberships   Membership[]

  adminProfile  AdminUser?
  notifications Notification[]

  @@index([email])
}

model Brand {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  description     String?
  logoUrl         String?
  website         String?
  isFeatured      Boolean      @default(false)
  status          BrandStatus  @default(PENDING)
  ownerId         String
  verificationDoc String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           User         @relation(fields: [ownerId], references: [id])
  products        Product[]
  memberships     Membership[]
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  vendorId   String?
  brandId    String?
  role       MembershipRole @default(STAFF)
  invitedBy  String?
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor     Vendor?        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  brand      Brand?         @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vendorId])
  @@index([brandId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkUrl   String?

  @@index([userId, isRead])
}

model Vendor {
  id              String  @id @default(cuid())
  userId          String  @unique
  slug            String  @unique
  name            String
  description     String?
  logoUrl         String?
  afterSalesPhone String?

  storeAuditLogs   StoreAuditLog[]
  storeSections    StoreSection[]
  storeTheme       StoreTheme?
  storeBanners     StoreBanner[]
  storeCollections StoreCollection[]
  storeFollowers   StoreFollower[]
  status           VendorStatus          @default(DRAFT)
  isIsource        Boolean               @default(false)
  location         String?
  commissionRate   Float                 @default(10)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  products         Product[]
  ledgerEntries    VendorLedgerEntry[]
  payouts          Payout[]
  memberships      Membership[]
  financeAccount   VendorFinanceAccount?

  @@index([status])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  shortName   String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  name                 String
  shortDescription     String
  description          String
  categoryId           String
  vendorId             String
  brandId              String?
  sku                  String                   @unique
  priceKobo            Int
  originalPriceKobo    Int?
  stock                Int                      @default(0)
  specs                Json
  tags                 String[]
  rating               Float                    @default(0)
  reviewCount          Int                      @default(0)
  warrantyRepair       Boolean                  @default(false)
  warrantyReplacement  Boolean                  @default(false)
  storeCollectionItems StoreCollectionProduct[]
  isActive             Boolean                  @default(true)
  isFeatured           Boolean                  @default(false)
  approvalStatus       ProductApprovalStatus    @default(APPROVED)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  category             Category                 @relation(fields: [categoryId], references: [id])
  vendor               Vendor                   @relation(fields: [vendorId], references: [id])
  brand                Brand?                   @relation(fields: [brandId], references: [id])
  images               ProductImage[]
  variants             ProductVariant[]
  reviews              ProductReview[]
  orderItems           OrderItem[]

  collections Collection[] @relation("ProductCollections")

  bundleItems        BundleItem[]
  cartItems          CartItem[]
  sponsoredCampaigns SponsoredCampaign[]

  weightGrams             Int     @default(0)
  lengthCm                Float   @default(0)
  widthCm                 Float   @default(0)
  heightCm                Float   @default(0)
  requiresSpecialHandling Boolean @default(false)

  @@index([categoryId, isActive])
  @@index([vendorId])
  @@index([brandId])
  @@index([slug])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  label      String
  sku        String      @unique
  stock      Int         @default(0)
  priceKobo  Int
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  qty       Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  bundleId String?
  bundle   Bundle?         @relation(fields: [bundleId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([cartId])
}

model Order {
  id                   String          @id @default(cuid())
  orderNumber          String          @unique
  userId               String?
  guestEmail           String?
  guestPhone           String?
  status               OrderStatus     @default(PENDING)
  paymentStatus        PaymentStatus   @default(PENDING)
  shippingFirstName    String
  shippingLastName     String
  shippingPhone        String
  shippingStreet       String
  shippingCity         String
  shippingState        String
  shippingPostalCode   String?
  shippingInstructions String?
  deliveryMethod       String
  paymentMethod        PaymentProvider
  subtotalKobo         Int
  deliveryKobo         Int
  discountKobo         Int             @default(0)
  totalKobo            Int
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User?           @relation(fields: [userId], references: [id])
  items                OrderItem[]
  payments             Payment[]
  shipments            Shipment[]
  refunds              Refund[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  productName       String
  variantLabel      String?
  sku               String
  unitKobo          Int
  qty               Int
  lineTotalKobo     Int
  vendorId          String
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  vendorManaged     Boolean           @default(false)
  createdAt         DateTime          @default(now())
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?          @relation(fields: [productId], references: [id])

  bundleId String?
  bundle   Bundle?         @relation(fields: [bundleId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@index([fulfillmentStatus])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  providerReference String?         @unique
  status            PaymentStatus   @default(PENDING)
  amountKobo        Int
  currency          String          @default("NGN")
  paidAt            DateTime?
  rawResponse       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerReference])
  @@index([status])
}

model Shipment {
  id              String            @id @default(cuid())
  orderId         String
  carrier         ShipmentCarrier   @default(ISOURCE)
  trackingNumber  String?
  status          FulfillmentStatus @default(PENDING)
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  proofOfDelivery String?
  podCollected    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  state         String
  city          String?
  feeKobo       Int
  freeAboveKobo Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([state])
}

model SiteSetting {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

model VendorLedgerEntry {
  id          String   @id @default(cuid())
  vendorId    String
  type        String
  amountKobo  Int
  description String
  orderId     String?
  payoutId    String?
  createdAt   DateTime @default(now())
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payout      Payout?  @relation(fields: [payoutId], references: [id])

  @@index([vendorId])
  @@index([type])
  @@index([createdAt])
}

model Payout {
  id            String              @id @default(cuid())
  vendorId      String
  amountKobo    Int
  status        String              @default("PENDING")
  method        String?
  reference     String?             @unique
  notes         String?
  processedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ledgerEntries VendorLedgerEntry[]

  @@index([vendorId])
  @@index([status])
}

model Refund {
  id          String    @id @default(cuid())
  orderId     String
  orderItemId String?
  amountKobo  Int
  reason      String
  status      String    @default("REQUESTED")
  requestedBy String
  reviewedBy  String?
  adminNotes  String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ============================================================
// LAYER 3: Admin, Audit, Storefront Studio
// ============================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CATALOGUE_MANAGER
  VENDOR_MANAGER
  BRAND_OFFICER
  ORDER_MANAGER
  FINANCE_OFFICER
  SUPPORT_OFFICER
  MARKETING_MANAGER
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum HomepageSectionType {
  FEATURED_CATEGORIES
  FLASH_DEALS
  BEST_SELLERS
  TRENDING
  RECENT
  CATEGORY_GRID
  BRAND_STORES
}

model AdminUser {
  id        String    @id @default(cuid())
  userId    String    @unique
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model HeroBanner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  ctaLabel    String?
  ctaUrl      String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaigns Campaign[]

  @@index([isActive, position])
}

model HomepageSection {
  id        String              @id @default(cuid())
  title     String
  subtitle  String?
  type      HomepageSectionType
  position  Int                 @default(0)
  isVisible Boolean             @default(true)
  config    Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isVisible, position])
}

// ============================================================
// LAYER 3 ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â Collections & Campaigns
// ============================================================

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("ProductCollections")

  @@index([slug])
}

model Campaign {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  themeColor  String      @default("#F07824")
  bannerId    String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  banner      HeroBanner? @relation(fields: [bannerId], references: [id])

  @@index([isActive, startDate, endDate])
}

// ============================================================
// LAYER 3 ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â Product Ranking & Sponsored Products
// ============================================================

model RankingConfig {
  id                 String   @id @default("singleton")
  relevanceWeight    Float    @default(30)
  salesWeight        Float    @default(25)
  conversionWeight   Float    @default(10)
  ratingWeight       Float    @default(15)
  stockWeight        Float    @default(10)
  deliveryWeight     Float    @default(5)
  completenessWeight Float    @default(5)
  updatedAt          DateTime @updatedAt
}

model SponsoredCampaign {
  id                   String              @id @default(cuid())
  productId            String
  budgetKobo           Int                 @default(0)
  spendKobo            Int                 @default(0)
  costPerClickKobo     Int                 @default(50)
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean             @default(true)
  priority             Int                 @default(0)
  impressions          Int                 @default(0)
  clicks               Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sponsoredPlacement   SponsoredPlacement? @relation(fields: [sponsoredPlacementId], references: [id])
  sponsoredPlacementId String?
  sponsoredEvents      SponsoredEvent[]

  @@index([isActive, startDate, endDate])
  @@index([productId])
}

// ============================================================
// Promo Banners (Editable from Admin)
// ============================================================
model PromoBanner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  ctaLabel  String
  ctaUrl    String
  imageUrl  String?
  theme     String   @default("orange") // "orange", "cream", "charcoal"
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Bundles (Solar, Holiday, etc.)
// ============================================================
model Bundle {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  description       String
  category          String   @default("solar-power")
  priceKobo         Int
  originalPriceKobo Int?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendorId String?
  brandId  String?

  items      BundleItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  qty       Int    @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ============================================================
// FINANCIAL DOMAIN — Payment, Ledger, & Settlement
// ============================================================

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  OPAY
  PALMPAY
  OTHER_WALLET
  OTHER
}

enum VendorOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  DISPUTED
}

enum SettlementStatus {
  PENDING
  ELIGIBLE
  REQUESTED
  APPROVED
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  ON_HOLD
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  SUCCESSFUL
  FAILED
  REJECTED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerJournalStatus {
  PENDING
  POSTED
  REVERSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PayoutMode {
  AUTOMATIC
  VENDOR_REQUEST
  ADMIN_APPROVED
}

model FinancePayment {
  id                String              @id @default(cuid())
  orderId           String              @unique
  customerId        String
  provider          PaymentProvider
  method            PaymentMethod?
  status            PaymentStatus       @default(PENDING)
  reference         String              @unique
  providerReference String?
  currency          String              @default("NGN")
  amountKobo        BigInt
  amountPaidKobo    BigInt              @default(0)
  checkoutUrl       String?
  paidAt            DateTime?
  expiresAt         DateTime?
  metadata          Json?
  attempts          PaymentAttempt[]
  refunds           FinanceRefund[]
  allocations       PaymentAllocation[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model PaymentAttempt {
  id                String         @id @default(cuid())
  paymentId         String
  providerReference String?
  status            PaymentStatus  @default(PENDING)
  amountKobo        BigInt
  method            PaymentMethod?
  failureReason     String?
  rawResponse       Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  payment           FinancePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

model PaymentAllocation {
  id            String             @id @default(cuid())
  paymentId     String
  vendorOrderId String
  amountKobo    BigInt
  currency      String             @default("NGN")
  payment       FinancePayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  vendorOrder   FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())

  @@unique([paymentId, vendorOrderId])
  @@index([vendorOrderId])
}

model FinanceVendorOrder {
  id                 String                 @id @default(cuid())
  orderId            String
  vendorId           String
  orderNumber        String                 @unique
  status             VendorOrderStatus      @default(PENDING)
  currency           String                 @default("NGN")
  subtotalKobo       BigInt
  discountKobo       BigInt                 @default(0)
  deliveryFeeKobo    BigInt                 @default(0)
  taxKobo            BigInt                 @default(0)
  totalKobo          BigInt
  commissionKobo     BigInt                 @default(0)
  gatewayFeeKobo     BigInt                 @default(0)
  vendorNetKobo      BigInt
  deliveredAt        DateTime?
  completedAt        DateTime?
  items              FinanceOrderItem[]
  delivery           FinanceDelivery?
  commission         CommissionTransaction?
  settlementItems    SettlementItem[]
  refunds            FinanceRefund[]
  disputes           FinanceDispute[]
  paymentAllocations PaymentAllocation[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  shippingFeeKobo BigInt  @default(0)
  deliveryMethod  String  @default("HOME_DELIVERY")
  pickupStationId String?

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@index([orderId])
}

model FinanceOrderItem {
  id                String             @id @default(cuid())
  vendorOrderId     String
  productId         String
  categoryId        String
  productName       String
  sku               String?
  quantity          Int
  unitPriceKobo     BigInt
  subtotalKobo      BigInt
  discountKobo      BigInt             @default(0)
  taxKobo           BigInt             @default(0)
  commissionRateBps Int
  commissionKobo    BigInt
  vendorOrder       FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())

  @@index([productId])
  @@index([categoryId])
  @@index([vendorOrderId])
}

model CategoryCommissionRule {
  id             String    @id @default(cuid())
  categoryId     String
  name           String
  rateBps        Int
  active         Boolean   @default(true)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([categoryId, active, effectiveFrom])
}

model CommissionTransaction {
  id             String             @id @default(cuid())
  vendorOrderId  String             @unique
  grossSalesKobo BigInt
  commissionKobo BigInt
  currency       String             @default("NGN")
  calculation    Json
  createdAt      DateTime           @default(now())
  vendorOrder    FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
}

model VendorFinanceAccount {
  id             String             @id @default(cuid())
  vendorId       String             @unique
  vendor         Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  currency       String             @default("NGN")
  bankAccountId  String?            @unique
  active         Boolean            @default(true)
  suspended      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  bankAccount    VendorBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  ledgerAccounts LedgerAccount[]
  settlements    VendorSettlement[]

  @@index([active, suspended])
}

model VendorBankAccount {
  id                String                @id @default(cuid())
  vendorId          String
  bankCode          String
  bankName          String
  accountNumberEnc  String
  accountLast4      String
  accountName       String
  providerRecipient String?
  verified          Boolean               @default(false)
  verifiedAt        DateTime?
  active            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  financeAccount    VendorFinanceAccount?

  @@index([vendorId, active])
}

model LedgerAccount {
  id               String                @id @default(cuid())
  financeAccountId String?
  code             String                @unique
  name             String
  type             LedgerAccountType
  currency         String                @default("NGN")
  financeAccount   VendorFinanceAccount? @relation(fields: [financeAccountId], references: [id], onDelete: Restrict)
  entries          LedgerEntry[]
  createdAt        DateTime              @default(now())

  @@index([financeAccountId, type])
}

model LedgerJournal {
  id             String              @id @default(cuid())
  reference      String              @unique
  description    String
  status         LedgerJournalStatus @default(PENDING)
  currency       String              @default("NGN")
  sourceType     String
  sourceId       String
  idempotencyKey String              @unique
  postedAt       DateTime?
  reversedAt     DateTime?
  entries        LedgerEntry[]
  createdAt      DateTime            @default(now())

  @@index([sourceType, sourceId])
  @@index([status, createdAt])
}

model LedgerEntry {
  id          String               @id @default(cuid())
  journalId   String
  accountId   String
  direction   LedgerEntryDirection
  amountKobo  BigInt
  description String?
  journal     LedgerJournal        @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account     LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  @@index([journalId])
  @@index([accountId, createdAt])
}

model FinanceDelivery {
  id                String             @id @default(cuid())
  vendorOrderId     String             @unique
  status            DeliveryStatus     @default(PENDING)
  courierName       String?
  trackingNumber    String?
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  customerConfirmed Boolean            @default(false)
  confirmedAt       DateTime?
  proofOfDelivery   String?
  recipientName     String?
  deliveryNotes     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  vendorOrder       FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)

  @@index([status, deliveredAt])
}

model VendorSettlement {
  id                String               @id @default(cuid())
  financeAccountId  String
  reference         String               @unique
  status            SettlementStatus     @default(PENDING)
  payoutMode        PayoutMode
  amountKobo        BigInt
  currency          String               @default("NGN")
  bankAccountId     String
  provider          PaymentProvider
  providerReference String?
  requestedAt       DateTime?
  approvedAt        DateTime?
  processedAt       DateTime?
  completedAt       DateTime?
  approvedBy        String?
  failureReason     String?
  financeAccount    VendorFinanceAccount @relation(fields: [financeAccountId], references: [id], onDelete: Restrict)
  items             SettlementItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([financeAccountId, status])
  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model SettlementItem {
  id            String             @id @default(cuid())
  settlementId  String
  vendorOrderId String
  amountKobo    BigInt
  settlement    VendorSettlement   @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  vendorOrder   FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())

  @@unique([settlementId, vendorOrderId])
  @@unique([vendorOrderId])
}

model FinanceRefund {
  id                String              @id @default(cuid())
  paymentId         String
  vendorOrderId     String?
  reference         String              @unique
  amountKobo        BigInt
  currency          String              @default("NGN")
  reason            String
  status            RefundStatus        @default(REQUESTED)
  providerReference String?
  approvedBy        String?
  processedAt       DateTime?
  payment           FinancePayment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  vendorOrder       FinanceVendorOrder? @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([paymentId, status])
  @@index([vendorOrderId, status])
}

model FinanceDispute {
  id            String             @id @default(cuid())
  vendorOrderId String
  customerId    String
  reason        String
  description   String?
  status        DisputeStatus      @default(OPEN)
  resolution    String?
  resolvedBy    String?
  resolvedAt    DateTime?
  vendorOrder   FinanceVendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([vendorOrderId, status])
}

model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  eventId        String
  eventType      String
  status         WebhookStatus   @default(RECEIVED)
  payload        Json
  signatureValid Boolean         @default(false)
  attempts       Int             @default(0)
  lastError      String?
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?

  @@unique([provider, eventId], name: "provider_eventId")
  @@index([status, receivedAt])
}

model IdempotencyRecord {
  id          String    @id @default(cuid())
  key         String    @unique
  operation   String
  requestHash String
  response    Json?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model FinanceOutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  attempts      Int       @default(0)
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@index([aggregateType, aggregateId])
}

// ============================================================
// Website Traffic Tracking
// ============================================================
model PageVisit {
  id        String   @id @default(cuid())
  path      String
  userId    String?
  ipHash    String?
  userAgent String?
  referrer  String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([ipHash, createdAt])
}

// ============================================================
// STORE DASHBOARD MODELS
// ============================================================
model StoreBanner {
  id              String           @id @default(cuid())
  vendorId        String
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  desktopUrl      String
  mobileUrl       String?
  heading         String?
  description     String?
  ctaLabel        String?
  ctaUrl          String?
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  startsAt        DateTime?
  endsAt          DateTime?
  approvalStatus  ModerationStatus @default(APPROVED)
  rejectionReason String?
}

model StoreCollection {
  id              String                   @id @default(cuid())
  vendorId        String
  vendor          Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  imageUrl        String?
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  products        StoreCollectionProduct[]
  approvalStatus  ModerationStatus         @default(APPROVED)
  rejectionReason String?

  @@unique([vendorId, slug])
}

model StoreCollectionProduct {
  id           String          @id @default(cuid())
  collectionId String
  collection   StoreCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int             @default(0)

  @@unique([collectionId, productId])
}

model StoreFollower {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
}

// ============================================================
// STORE SECTIONS & THEME (Phase 5)
// ============================================================
enum StoreSectionType {
  HERO
  COLLECTIONS
  FEATURED_PRODUCTS
  ALL_PRODUCTS
  BRAND_STORY
  REVIEWS
  WARRANTY_INFO
}

model StoreSection {
  id        String           @id @default(cuid())
  vendorId  String
  vendor    Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      StoreSectionType
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  config    Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([vendorId, type])
}

model StoreTheme {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  accentColor     String   @default("#F58220")
  backgroundColor String   @default("#FFFFFF")
  buttonStyle     String   @default("rounded-lg")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// ADMIN MODERATION
// ============================================================
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// STORE AUDIT LOG (Phase 11)
// ============================================================
model StoreAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String // "banner.create" | "banner.approve" | "collection.delete" | ...
  entityType String // "StoreBanner" | "StoreCollection" | "StoreTheme" | "StoreSection"
  entityId   String
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SponsoredPlacement {
  id               String              @id @default(cuid())
  slug             String              @unique
  name             String
  location         String
  pricingModel     String              @default("CPC")
  minBidKobo       Int                 @default(50)
  maxBidKobo       Int                 @default(50000)
  cpmRateKobo      Int                 @default(0)
  fixedRateKobo    Int                 @default(0)
  maxSlots         Int                 @default(4)
  isActive         Boolean             @default(true)
  requiresApproval Boolean             @default(true)
  eligibilityJson  Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  campaigns        SponsoredCampaign[]
  featured         FeaturedPlacement[]

  @@index([isActive, location])
}

model SponsoredEvent {
  id             String            @id @default(cuid())
  campaignId     String
  productId      String?
  eventType      String
  sessionId      String?
  ipHash         String?
  uaHash         String?
  idempotencyKey String            @unique
  validated      Boolean           @default(true)
  billed         Boolean           @default(false)
  billableKobo   BigInt            @default(0)
  metadata       Json?
  createdAt      DateTime          @default(now())
  campaign       SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, eventType, createdAt])
  @@index([createdAt])
}

model AdvertisingWallet {
  id                String                         @id @default(cuid())
  vendorId          String                         @unique
  availableKobo     BigInt                         @default(0)
  reservedKobo      BigInt                         @default(0)
  lifetimeSpentKobo BigInt                         @default(0)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  transactions      AdvertisingWalletTransaction[]
}

model AdvertisingWalletTransaction {
  id               String            @id @default(cuid())
  walletId         String
  type             String
  amountKobo       BigInt
  balanceAfterKobo BigInt
  reference        String
  campaignId       String?
  metadata         Json?
  createdAt        DateTime          @default(now())
  wallet           AdvertisingWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([reference, type])
  @@index([walletId, createdAt])
  @@index([campaignId])
}

model FeaturedPlacement {
  id           String             @id @default(cuid())
  vendorId     String
  productId    String?
  placementId  String
  bookingType  String             @default("PRODUCT")
  startAt      DateTime
  endAt        DateTime
  feeKobo      BigInt
  status       String             @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  placement    SponsoredPlacement @relation(fields: [placementId], references: [id])

  @@index([placementId, status, startAt, endAt])
  @@index([vendorId, status])
}

model MarketplaceCampaignParticipation {
  id           String    @id @default(cuid())
  vendorId     String
  campaignId   String
  productIds   String[]  @default([])
  feeKobo      BigInt    @default(0)
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([campaignId, status])
  @@index([vendorId, status])
}

model SponsoredApproval {
  id         String   @id @default(cuid())
  campaignId String
  action     String
  actorId    String
  note       String?
  createdAt  DateTime @default(now())

  @@index([campaignId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// SHIPPING & LOGISTICS ENGINE (Phase 2)
// ═══════════════════════════════════════════════════════════════

model ShippingZone {
  id        String          @id @default(cuid())
  name      String
  states    String[]
  cities    String[]
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  rates     ShippingRate[]
  stations  PickupStation[]

  @@index([isActive])
}

model ShippingProvider {
  id             String         @id @default(cuid())
  name           String
  code           String         @unique
  isInternal     Boolean        @default(false)
  isActive       Boolean        @default(true)
  supportsPickup Boolean        @default(true)
  supportsHome   Boolean        @default(true)
  apiConfig      Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  rates          ShippingRate[]

  @@index([isActive])
}

model ShippingRate {
  id                 String           @id @default(cuid())
  providerId         String
  zoneId             String
  minWeightGrams     Int              @default(0)
  maxWeightGrams     Int              @default(100000)
  basePriceKobo      BigInt
  pricePerKgKobo     BigInt           @default(0)
  pickupDiscountKobo BigInt           @default(0)
  createdAt          DateTime         @default(now())
  provider           ShippingProvider @relation(fields: [providerId], references: [id])
  zone               ShippingZone     @relation(fields: [zoneId], references: [id])

  @@index([providerId, zoneId])
}

model PickupStation {
  id        String       @id @default(cuid())
  zoneId    String
  name      String
  address   String
  latitude  Float?
  longitude Float?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  zone      ShippingZone @relation(fields: [zoneId], references: [id])

  @@index([zoneId, isActive])
}

model ShippingQuote {
  id                String   @id @default(cuid())
  customerId        String
  providerId        String
  zoneId            String
  deliveryMethod    String
  weightGrams       Int
  calculatedFeeKobo BigInt
  discountKobo      BigInt   @default(0)
  finalFeeKobo      BigInt
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([customerId, expiresAt])
}

model ShipmentTrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String
  location    String?
  createdAt   DateTime @default(now())

  @@index([shipmentId, createdAt])
}

model ShippingFinancialLedger {
  id                  String   @id @default(cuid())
  shipmentId          String   @unique
  customerPaidKobo    BigInt
  actualCostKobo      BigInt
  platformSubsidyKobo BigInt   @default(0)
  sellerFundedKobo    BigInt   @default(0)
  status              String   @default("PENDING")
  createdAt           DateTime @default(now())

  @@index([status])
}

model ShippingPolicyAcceptance {
  id         String   @id @default(cuid())
  orderId    String
  userId     String
  version    String   @default("1.0")
  acceptedAt DateTime @default(now())
  ipHash     String?

  @@index([orderId])
  @@index([userId, acceptedAt])
}
